{
  "name": "nightsmith",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native local blockchain cockpit for Foundry Anvil",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.5.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @nightsmith/server dev",
    "dev:web": "pnpm --filter @nightsmith/web dev",
    "demo": "pnpm --filter @nightsmith/server demo",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
