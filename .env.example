# Blacksmith environment configuration (example).
# Copy to `.env` and adjust. Every value is OPTIONAL — sensible defaults apply,
# and the default `mock` planner needs no key.
#
# Blacksmith auto-loads `.env` from the working directory on startup. Real shell
# exports take precedence over `.env`. Point elsewhere with BLACKSMITH_ENV_FILE.

# ── Server ───────────────────────────────────────────────
BLACKSMITH_PORT=4040
BLACKSMITH_HOST=127.0.0.1

# ── Anvil ────────────────────────────────────────────────
BLACKSMITH_ANVIL_PORT=8545

# ── Data / sessions ──────────────────────────────────────
# Where manifests, sessions, and AI credentials are stored.
# BLACKSMITH_DATA_DIR=~/.blacksmith

# ── AI provider ──────────────────────────────────────────
# mock (default, offline, no key) | openai | codex (no key; uses local Codex CLI login)
BLACKSMITH_AI_PROVIDER=mock
# OpenAI API key — overrides any key saved via the cockpit Connect dialog.
# OPENAI_API_KEY=sk-...
# OpenAI model used for planning.
BLACKSMITH_OPENAI_MODEL=gpt-5.5

# ── Safety opt-ins (default: local-only) ─────────────────
# Allow forking a remote chain (manifest network.forkUrl).
BLACKSMITH_ALLOW_FORK=false
# Allow broadcasting beyond the local node.
BLACKSMITH_ALLOW_BROADCAST=false

# ── Web dev only ─────────────────────────────────────────
# Backend the Vite dev server proxies /api and /ws to.
# BLACKSMITH_SERVER=http://127.0.0.1:4040
# Override the built web UI directory served by `blacksmith serve`.
# BLACKSMITH_WEB_DIST=
