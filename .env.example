# Nightsmith environment configuration (example).
# Copy to `.env` and adjust. Every value is OPTIONAL — sensible defaults apply,
# and the default planner needs no key (auto: OpenAI key → Codex CLI → mock).
#
# Nightsmith auto-loads `.env` from the working directory on startup. Real shell
# exports take precedence over `.env`. Point elsewhere with NIGHTSMITH_ENV_FILE.

# ── Server ───────────────────────────────────────────────
NIGHTSMITH_PORT=4040
NIGHTSMITH_HOST=127.0.0.1

# ── Anvil ────────────────────────────────────────────────
NIGHTSMITH_ANVIL_PORT=8545
# Override where the anvil binary is found (advanced; default ~/.foundry/bin).
# FOUNDRY_BIN_DIR=

# ── Data / sessions ──────────────────────────────────────
# Where manifests, sessions, and AI credentials are stored.
# NIGHTSMITH_DATA_DIR=~/.nightsmith

# ── AI provider (automatic: OpenAI key → Codex CLI → mock) ─
# OpenAI API key — overrides any key saved via the cockpit. Standard OpenAI var
# name (no prefix), so an existing shell key is picked up automatically.
# OPENAI_API_KEY=sk-...
# OpenAI model used for planning.
NIGHTSMITH_OPENAI_MODEL=gpt-5.5

# ── Safety opt-ins (default: local-only) ─────────────────
# Allow forking a remote chain (manifest network.forkUrl).
NIGHTSMITH_ALLOW_FORK=false
# Allow broadcasting beyond the local node.
NIGHTSMITH_ALLOW_BROADCAST=false
# Extra allowed Host header values (comma-separated) beyond localhost.
# NIGHTSMITH_ALLOWED_HOSTS=

# ── Web dev only ─────────────────────────────────────────
# Backend the Vite dev server proxies /api and /ws to.
# NIGHTSMITH_SERVER=http://127.0.0.1:4040
# Override the built web UI directory served by `nightsmith serve`.
# NIGHTSMITH_WEB_DIST=
