{
  "name": "@nightsmith/server",
  "version": "0.1.0",
  "type": "module",
  "description": "Nightsmith — AI-native local blockchain cockpit for Foundry Anvil (server + CLI)",
  "bin": {
    "nightsmith": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "demo": "tsx src/demo.ts",
    "demo:extend": "tsx src/demo-extend.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js serve",
    "prepack": "pnpm --filter @nightsmith/web build && tsup && node -e \"require('fs').rmSync('web-dist',{recursive:true,force:true});require('fs').cpSync('../web/dist','web-dist',{recursive:true})\""
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nightsmith/contracts": "workspace:*",
    "@nightsmith/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
